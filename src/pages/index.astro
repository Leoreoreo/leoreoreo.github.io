---
import { Image } from 'astro:assets'

import { Button, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Card from '@/components/home/Card.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import avatar from '@/assets/avatar.png'
import config from '@/site-config'

const programming = [
  'Python',
  'JavaScript',
  'TypeScript',
  'C/C++',
  'Java',
  'Clojure',
  'SQL',
  'HTML & CSS'
]
const tools = [
  'React',
  'Node.js',
  'Next.js',
  'Vite',
  'Flask',
  'Sanic',
  'Django',
  'RESTful API',
  'MySQL',
  'SQLite3',
  'PostgreSQL',
  'HBase'
]
const dataScience = [
  'PyTorch',
  'scikit-learn',
  'semopy',
  'NumPy',
  'SentenceTransformers',
  'D3.js',
  'Matplotlib',
  'pandas'
]
const infrastructure = ['AWS EC2', 'Docker', 'Kubernetes', 'Flink', 'Kafka', 'HDFS']
---

<PageLayout meta={{ title: 'Home' }}>
  <main id='main-content' class='flex w-full flex-col items-center'>
    <section class='mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <Image
        src={avatar}
        alt='Leyang Li'
        class='h-28 w-auto rounded-full border p-1'
        loading='eager'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-bold'>{config.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='Baltimore, MD'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label title='Email' as='a' href='mailto:lli184@jh.edu'>
            <Icon name='email' class='size-5' slot='icon' />
          </Label>
          <Label title='GitHub' as='a' href='https://github.com/Leoreoreo'>
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>
    </section>

    <div id='content' class='flex flex-col gap-y-10 w-full'>
      <Section title='About'>
        <p class='text-muted-foreground'>HCI, Privacy, and Security Researcher</p>
        <p class='text-muted-foreground'>
          I am a Ph.D. student in Computer Science at <a href='https://www.jhu.edu'
            >Johns Hopkins University</a
          >. My research interests lie at the intersection of usable privacy and security,
          human-computer interaction, and human-centered AI.
        </p>
        <Button title='More about me' class='w-fit self-end' href='/about' variant='ahead' />
      </Section>

      <Section title='Publications'>
        <Card
          heading='Why am I seeing this: Democratizing End User Auditing for Online Content Recommendations'
          subheading='Chaoran Chen, Leyang Li, Luke Cao, Yanfang Ye, Tianshi Li, Yaxing Yao, Toby Jia-Jun Li'
          date='In Proceedings of the 38th Annual ACM Symposium on User Interface Software and Technology'
        >
          <div class='flex items-center gap-2 justify-end'>
            <span>[UIST'25]</span>
            <a
              href='https://dl.acm.org/doi/10.1145/3746059.3747798'
              target='_blank'
              rel='noopener noreferrer'
              aria-label='Read paper'>Paper</a
            >
            <a
              href='https://www.youtube.com/watch?v=3I_zgTW02a8'
              target='_blank'
              rel='noopener noreferrer'
              aria-label='Watch project video'>Video</a
            >
          </div>
        </Card>

        <Card
          heading='AROMA: Mixed-Initiative AI Assistance for Non-Visual Cooking by Grounding Multimodal Information Between Reality and Videos'
          subheading='Zheng Ning, Leyang Li, Daniel Killough, JooYoung Seo, Patrick Carrington, Yapeng Tian, Yuhang Zhao, Franklin Mingzhe Li, Toby Jia-Jun Li'
          date='In Proceedings of the 38th Annual ACM Symposium on User Interface Software and Technology'
        >
          <div class='flex items-center gap-2 justify-end'>
            <span>[UIST'25]</span>
            <a
              href='https://dl.acm.org/doi/10.1145/3746059.3747650'
              target='_blank'
              rel='noopener noreferrer'
              aria-label='Read paper'>Paper</a
            >
            <a
              href='https://www.youtube.com/watch?v=hi7YsFJp5KQ'
              target='_blank'
              rel='noopener noreferrer'
              aria-label='Watch project video'>Video</a
            >
          </div>
        </Card>
      </Section>

      <Section title='Education'>
        <Card
          as='a'
          heading='Johns Hopkins University'
          subheading='Ph.D. in Computer Science'
          date='Aug. 2026 - Present'
          href='https://jhu.edu'
        />

        <Card
          as='a'
          heading='University of Notre Dame'
          subheading='B.S. in Computer Science; supplementary major in Applied Mathematics and Statistics'
          date='Aug. 2022 - May 2026'
          href='https://nd.edu'
        >
          <p>GPA: 3.95/4.00 (magna cum laude)</p>
        </Card>
      </Section>

      <Section title='Experience'>
        <Card
          heading='Research Intern'
          subheading='SPUD Lab, HCII, Carnegie Mellon University'
          date='May 2025 - Feb. 2026'
        >
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>Advised by Prof. Sauvik Das.</li>
            <li>
              SP-ABCBench: A benchmark to simulate and evaluate LLM agents' privacy attitudes and
              behaviors.
            </li>
          </ul>
        </Card>
        <Card
          heading='Research Assistant'
          subheading='SaNDwich Lab, University of Notre Dame'
          date='Sept. 2023 - May 2025'
        >
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>Advised by Prof. Toby Jia-Jun Li.</li>
            <li>
              AROMA: A multimodal cooking assistant for blind and low-vision users, providing both
              reactive and proactive assistance.
            </li>
            <li>
              Privacy Auditing Sandbox: An interactive interface for end-user auditing of online
              content recommendations using AI-generated virtual personas.
            </li>
          </ul>
        </Card>
        <Card
          heading='Teaching Assistant & Tutor'
          subheading='CSE Department, University of Notre Dame'
        >
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>Operating System Principles: Spring and Fall 2025</li>
            <li>Distributed Systems: Spring 2026</li>
          </ul>
        </Card>
        <Card
          heading='Software Engineer Intern'
          subheading='China Construction Bank Fintech'
          date='Jun. - Aug. 2024'
        >
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>Maintained a big data system using a Flink-based Kafka consumer.</li>
          </ul>
        </Card>
        <Card
          heading='Data Analyst Intern'
          subheading='Everbright Securities Asset Management'
          date='Jul. - Aug. 2023'
        >
          <ul class='ms-4 list-disc text-muted-foreground'>
            <li>
              Applied machine learning to investment analysis using a GRU with multi-head
              self-attention.
            </li>
          </ul>
        </Card>
      </Section>

      <Section title='Honors'>
        <Card
          as='a'
          heading='Second Place, Hesburgh Libraries Hackathon 2026'
          subheading='Apr. 2026, University of Notre Dame, ($2,000)'
          href='https://hackathon.library.nd.edu/2026.shtml'
        />
        <Card
          heading='Dean’s Honor List'
          subheading='Every semester, 2023–2025, University of Notre Dame'
        />
        <Card
          as='a'
          heading='First Place, Hesburgh Libraries Hackathon 2025'
          subheading='Apr. 2025, University of Notre Dame, ($3,000)'
          href='https://hackathon.library.nd.edu/2025.shtml'
        />
        <Card
          as='a'
          heading='Best Use of External Data, ASA DataFest 2025 at Notre Dame'
          subheading='Mar. 2025, American Statistical Association, ($1,000)'
          href='https://vweber1.wixsite.com/datafest-nd/'
        />
        <Card
          heading='Frank Reilly Scholar'
          subheading='2024, University of Notre Dame, ($5,000)'
        />
        <Card
          as='a'
          heading='Second Place, Hesburgh Libraries Hackathon 2024'
          subheading='Apr. 2024, University of Notre Dame, ($2,000)'
          href='https://hackathon.library.nd.edu/2024.shtml'
        />
        <Card
          heading='Greater China Scholar'
          subheading='2022, University of Notre Dame, ($5,000)'
        />
      </Section>

      <Section title='Skills'>
        <SkillLayout title='Programming' skills={programming} />
        <SkillLayout title='Tools' skills={tools} />
        <SkillLayout title='Data Science & ML' skills={dataScience} />
        <SkillLayout title='Infrastructure' skills={infrastructure} />
      </Section>
    </div>
  </main>
</PageLayout>
