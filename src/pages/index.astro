---
import { Image } from 'astro:assets'

import PageLayout from '@/layouts/BaseLayout.astro'
import Card from '@/components/home/Card.astro'
import Section from '@/components/home/Section.astro'
import avatar from '@/assets/avatar.png'
import aroma from '@/assets/projects/AROMA.png'
import sandbox from '@/assets/projects/PrivacySandbox.png'

const publications = [
  {
    title:
      'Why am I seeing this: Democratizing End User Auditing for Online Content Recommendations',
    authors: [
      'Chaoran Chen',
      'Leyang Li',
      'Luke Cao',
      'Yanfang Ye',
      'Tianshi Li',
      'Yaxing Yao',
      'Toby Jia-Jun Li'
    ],
    image: sandbox,
    alt: 'Privacy Auditing Sandbox interface',
    summary:
      'An interactive interface for auditing content recommendations with AI-generated virtual personas.',
    paper: 'https://dl.acm.org/doi/10.1145/3746059.3747798',
    video: 'https://www.youtube.com/watch?v=3I_zgTW02a8'
  },
  {
    title:
      'AROMA: Mixed-Initiative AI Assistance for Non-Visual Cooking by Grounding Multimodal Information Between Reality and Videos',
    authors: [
      'Zheng Ning',
      'Leyang Li',
      'Daniel Killough',
      'JooYoung Seo',
      'Patrick Carrington',
      'Yapeng Tian',
      'Yuhang Zhao',
      'Franklin Mingzhe Li',
      'Toby Jia-Jun Li'
    ],
    image: aroma,
    alt: 'AROMA cooking assistant overview',
    summary:
      'Multimodal assistance for blind and low-vision cooks, combining reactive and proactive support.',
    paper: 'https://dl.acm.org/doi/10.1145/3746059.3747650',
    video: 'https://www.youtube.com/watch?v=hi7YsFJp5KQ'
  }
]
---

<PageLayout meta={{ title: 'Home' }}>
  <main id='main-content' class='research-home'>
    <section class='profile-intro' aria-labelledby='profile-name'>
      <div class='profile-copy'>
        <h1 id='profile-name'>Leyang Li</h1>
        <p class='profile-role'>Ph.D. student in Computer Science at Johns Hopkins University</p>
        <p>
          I study <strong>usable privacy and security</strong>, <strong
            >human-computer interaction</strong
          >, and <strong>human-centered AI</strong>.
        </p>
        <p>
          I am a Ph.D. student at <a href='https://www.jhu.edu'>Johns Hopkins University</a>,
          advised by <a href='https://www.cs.jhu.edu/~yaxing/index.html'>Prof. Yaxing Yao</a>. I
          received my B.S. in Computer Science from the University of Notre Dame in 2026, where I
          worked with <a href='https://toby.li/'>Prof. Toby Jia-Jun Li</a> in the SaNDwich Lab. I also
          worked with <a href='https://sauvik.me/'>Prof. Sauvik Das</a> in CMU’s SPUD Lab in summer 2025.
        </p>
        <div class='profile-links' aria-label='Contact and professional links'>
          <a class='contact-primary' href='mailto:lli184@jh.edu' aria-label='Email' title='Email'>
            <svg
              width='22'
              height='22'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='1.7'
              aria-hidden='true'
              ><rect x='3' y='5' width='18' height='14' rx='2'></rect><path d='m3 6 9 7 9-7'
              ></path></svg
            >
          </a>
          <a href='https://github.com/Leoreoreo' aria-label='GitHub' title='GitHub'>
            <svg width='22' height='22' viewBox='0 0 24 24' fill='currentColor' aria-hidden='true'
              ><path
                d='M12 .8a11.2 11.2 0 0 0-3.54 21.82c.56.1.77-.24.77-.54v-2.09c-3.12.68-3.78-1.33-3.78-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.68.08-.68 1.13.08 1.72 1.15 1.72 1.15 1 .1 1.7 2.18 3.28 1.1.1-.73.39-1.22.71-1.5-2.49-.28-5.11-1.24-5.11-5.54 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.08 1.15a10.7 10.7 0 0 1 5.6 0c2.14-1.45 3.08-1.15 3.08-1.15.61 1.54.23 2.68.11 2.96.71.78 1.15 1.78 1.15 3 0 4.31-2.63 5.25-5.13 5.53.4.35.76 1.03.76 2.08v3.03c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z'
              ></path></svg
            >
          </a>
          <a
            href='https://scholar.google.com/citations?user=lNk_5IAAAAAJ&hl=en'
            aria-label='Google Scholar'
            title='Google Scholar'
          >
            <svg width='22' height='22' viewBox='0 0 24 24' fill='currentColor' aria-hidden='true'
              ><path d='M12 2 0 10l4 2.67V9.5L12 4l8 5.5v3.17L24 10Z'></path><circle
                cx='12'
                cy='15'
                r='7'></circle></svg
            >
          </a>
        </div>
      </div>
      <figure class='profile-photo'>
        <Image src={avatar} alt='Leyang Li' width={280} loading='eager' fetchpriority='high' />
      </figure>
    </section>

    <nav class='research-nav' aria-label='On this page'>
      <a href='#publications'>Publications</a>
      <a href='#education'>Education</a>
      <a href='#research-experience'>Research experience</a>
      <a href='#teaching'>Teaching</a>
    </nav>

    <section class='academic-section' id='publications' aria-labelledby='publications-heading'>
      <div class='section-heading'>
        <div><p class='eyebrow'>Research</p><h2 id='publications-heading'>Publications</h2></div>
        <a class='quiet-link' href='/projects'>All projects <span aria-hidden='true'>↗</span></a>
      </div>
      <div class='publication-list'>
        {
          publications.map((publication) => (
            <article class='publication'>
              <a
                class='publication-image'
                href={publication.paper}
                aria-label={`Read ${publication.title}`}
              >
                <Image src={publication.image} alt={publication.alt} width={440} loading='lazy' />
              </a>
              <div class='publication-copy'>
                <span class='venue-badge'>UIST 2025</span>
                <h3>
                  <a href={publication.paper}>{publication.title}</a>
                </h3>
                <p class='authors'>
                  {publication.authors.map((author, index) => (
                    <Fragment>
                      {index > 0 && ', '}
                      {author === 'Leyang Li' ? <strong>{author}</strong> : author}
                    </Fragment>
                  ))}
                </p>
                <p class='publication-venue'>
                  38th ACM Symposium on User Interface Software and Technology
                </p>
                <p class='publication-summary'>{publication.summary}</p>
                <div class='publication-links'>
                  <a href={publication.paper} aria-label={`Paper: ${publication.title}`}>
                    Paper <span aria-hidden='true'>↗</span>
                  </a>
                  <a href={publication.video} aria-label={`Video: ${publication.title}`}>
                    Video <span aria-hidden='true'>↗</span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class='academic-section' id='education' aria-labelledby='education-heading'>
      <div class='section-heading'><h2 id='education-heading'>Education</h2></div>
      <div class='academic-row'>
        <p class='row-date'>2026 — present</p>
        <div>
          <h3>Johns Hopkins University</h3><p>Ph.D. in Computer Science</p>
          <p class='row-detail'>
            Advisor: <a href='https://www.cs.jhu.edu/~yaxing/index.html'>Prof. Yaxing Yao</a>
          </p>
        </div>
      </div>
      <div class='academic-row'>
        <p class='row-date'>2022 — 2026</p>
        <div>
          <h3>University of Notre Dame</h3><p>B.S. in Computer Science, magna cum laude</p>
          <p class='row-detail'>
            Supplementary major in Applied Mathematics and Statistics · GPA: 3.95/4.00
          </p>
        </div>
      </div>
    </section>

    <section class='academic-section' id='research-experience' aria-labelledby='experience-heading'>
      <div class='section-heading'><h2 id='experience-heading'>Research experience</h2></div>
      <div class='academic-row'>
        <p class='row-date'>May 2025 — Feb. 2026</p>
        <div>
          <h3>Research Intern · Carnegie Mellon University</h3>
          <p>SPUD Lab, Human-Computer Interaction Institute · Prof. Sauvik Das</p>
          <p class='row-detail'>
            SP-ABCBench: simulating and evaluating LLM agents’ privacy attitudes and behaviors.
          </p>
        </div>
      </div>
      <div class='academic-row'>
        <p class='row-date'>Sept. 2023 — May 2025</p>
        <div>
          <h3>Research Assistant · University of Notre Dame</h3>
          <p>SaNDwich Lab · Prof. Toby Jia-Jun Li</p>
          <p class='row-detail'>
            Research on non-visual cooking assistance and end-user auditing of content
            recommendations.
          </p>
        </div>
      </div>
    </section>

    <section class='academic-section' id='teaching' aria-labelledby='teaching-heading'>
      <div class='section-heading'><h2 id='teaching-heading'>Teaching</h2></div>
      <p class='section-description'>
        Teaching Assistant &amp; Tutor · Computer Science and Engineering, University of Notre Dame
      </p>
      <div class='teaching-row'><h3>CSE 40771 Distributed Systems</h3><p>Spring 2026</p></div>
      <div class='teaching-row'>
        <h3>CSE 30341 Operating System Principles</h3><p>Spring &amp; Fall 2025 · Spring 2026</p>
      </div>
    </section>

    <details class='additional-background'>
      <summary>More background <span>Honors and industry experience</span></summary>
      <div class='additional-content'>
        <Section title='Honors'>
          <Card
            as='a'
            heading='Second Place, Hesburgh Libraries Hackathon 2026'
            subheading='Apr. 2026, University of Notre Dame, ($2,000)'
            href='https://hackathon.library.nd.edu/2026.shtml'
          />
          <Card
            heading='Dean’s Honor List'
            subheading='Every semester, 2023–2025, University of Notre Dame'
          />
          <Card
            as='a'
            heading='First Place, Hesburgh Libraries Hackathon 2025'
            subheading='Apr. 2025, University of Notre Dame, ($3,000)'
            href='https://hackathon.library.nd.edu/2025.shtml'
          />
          <Card
            as='a'
            heading='Best Use of External Data, ASA DataFest 2025 at Notre Dame'
            subheading='Mar. 2025, American Statistical Association, ($1,000)'
            href='https://vweber1.wixsite.com/datafest-nd/'
          />
          <Card
            heading='Frank Reilly Scholar'
            subheading='2024, University of Notre Dame, ($5,000)'
          />
          <Card
            as='a'
            heading='Second Place, Hesburgh Libraries Hackathon 2024'
            subheading='Apr. 2024, University of Notre Dame, ($2,000)'
            href='https://hackathon.library.nd.edu/2024.shtml'
          />
          <Card
            heading='Greater China Scholar'
            subheading='2022, University of Notre Dame, ($5,000)'
          />
        </Section>
        <Section title={'Industry\nexperience'}>
          <Card
            heading='Software Engineer Intern'
            subheading='China Construction Bank Fintech'
            date='Jun. - Aug. 2024'
          >
            <ul class='ms-4 list-disc text-muted-foreground'>
              <li>Maintained a big data system using a Flink-based Kafka consumer.</li>
            </ul>
          </Card>
          <Card
            heading='Data Analyst Intern'
            subheading='Everbright Securities Asset Management'
            date='Jul. - Aug. 2023'
          >
            <ul class='ms-4 list-disc text-muted-foreground'>
              <li>
                Applied machine learning to investment analysis using a GRU with multi-head
                self-attention.
              </li>
            </ul>
          </Card>
        </Section>
      </div>
    </details>

    <aside class='personal-note'>
      <a href='/about'>A little more about me <span aria-hidden='true'>→</span></a>
    </aside>
  </main>
</PageLayout>
