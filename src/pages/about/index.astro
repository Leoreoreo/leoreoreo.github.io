---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import PageLayout from '@/layouts/CommonPage.astro'

const headings = [
  { depth: 2, slug: 'hiking', text: 'National parks' },
  { depth: 2, slug: 'painting', text: 'Painting' }
]
const parkNames = [
  'Grand Canyon (Arizona)',
  'Yellowstone (Wyoming)',
  'Arches (Utah)',
  'Olympic (Washington)',
  'Mount Rainier (Washington)',
  'Everglades (Florida)',
  'Acadia (Maine)',
  'Saguaro (Arizona)',
  'Bryce Canyon (Utah)',
  'Canyonlands (Utah)',
  'Black Canyon of the Gunnison (Colorado)',
  'North Cascades (Washington)',
  'Shenandoah (Virginia)',
  'Mammoth Cave (Kentucky)',
  'Biscayne (Florida)',
  'Petrified Forest (Arizona)',
  'Mesa Verde (Colorado)',
  'Indiana Dunes (Indiana)'
]
const artwork = import.meta.glob<{ default: ImageMetadata }>('/public/arts/*.gif', { eager: true })
const paintings = [
  { file: 'statue', label: 'Statue study' },
  { file: 'guard', label: 'Guard study' },
  { file: 'life', label: 'Still life' },
  { file: 'DV', label: 'DV painting' },
  { file: 'Hannibal', label: 'Hannibal portrait' },
  { file: 'cat', label: 'Cat portrait' }
].map((painting) => {
  const image = artwork[`/public/arts/${painting.file}.gif`].default
  return { ...painting, ratio: image.width / image.height }
})
const photos = import.meta.glob<{ default: ImageMetadata }>('/public/National Parks/*.{jpg,jpeg}', {
  eager: true
})
const descriptions: Record<string, string> = {
  'Grand Canyon': 'Layered canyon walls under a blue, cloud-filled sky',
  Yellowstone: 'Steam rising above a colorful hot spring beneath a blue sky',
  'Bryce Canyon': 'Rows of orange hoodoos stretching across the canyon',
  'Indiana Dunes': 'Sandy dunes beside Lake Michigan with a distant city skyline',
  Arches: 'Red sandstone arches framing the blue sky',
  Olympic: 'Sunlight filtering through a moss-covered forest',
  'Mount Rainier': 'Snow-covered mountain ridges above the clouds',
  Everglades: 'An alligator among lily pads and wetland vegetation',
  Acadia: 'Autumn forest and coastal islands beneath golden mist',
  Saguaro: 'Tall saguaro cacti across a desert landscape',
  Canyonlands: 'Expansive canyons and mesas seen from a rocky overlook',
  'Black Canyon of the Gunnison': 'Steep canyon walls with patches of snow',
  'North Cascades': 'A turquoise lake surrounded by forested mountains',
  Shenandoah: 'Autumn-colored mountain slopes beyond a rocky overlook',
  'Mammoth Cave': 'Illuminated rock formations inside a cavern',
  Biscayne: 'An iguana resting on sunlit rocks',
  'Petrified Forest': 'Pale, eroded badlands stretching toward the horizon',
  'Mesa Verde': 'Cliff dwellings sheltered beneath a sandstone overhang'
}
const nationalParks = parkNames.map((label, index) => {
  const [name, state] = label.replace(')', '').split(' (')
  const photoPath = ['jpeg', 'jpg']
    .map((extension) => `/public/National Parks/${name}.${extension}`)
    .find((path) => photos[path])
  return {
    name,
    state,
    rank: index + 1,
    photo: photoPath ? photos[photoPath].default : undefined,
    original: photoPath ? encodeURI(photoPath.replace('/public', '')) : '',
    alt: descriptions[name]
  }
})
const photographedParks = nationalParks.filter((park) => park.photo)
---

<PageLayout title='About' {headings}>
  <div class='about-page'>
    <section class='about-section' aria-labelledby='hiking'>
      <div class='about-section-heading'>
        <div>
          <p class='eyebrow'>On the trail</p><h2 id='hiking'>Hiking &amp; national parks</h2>
        </div>
        <span class='collection-count'>{photographedParks.length} photographs</span>
      </div>
      <p>
        Places I’ve explored, through my own lens. The numbers follow my personal ranking of the
        parks I’ve visited.
      </p>
      <details class='park-directory'>
        <summary
          >All {nationalParks.length} parks, in order <span>View the complete list</span></summary
        >
        <ol>
          {
            nationalParks.map((park) => (
              <li>
                <span class='park-number' aria-hidden='true'>
                  {String(park.rank).padStart(2, '0')}
                </span>
                <div>
                  {park.photo ? (
                    <a href={`#park-${park.rank}`}>{park.name}</a>
                  ) : (
                    <span>{park.name}</span>
                  )}
                  <small>
                    {park.state}
                    {!park.photo && ' · No photo yet'}
                  </small>
                </div>
              </li>
            ))
          }
        </ol>
      </details>
      <div class='gallery-tools' hidden>
        <label for='park-search'>Find a photograph</label>
        <div class='search-row'>
          <input
            id='park-search'
            type='search'
            placeholder='Search by park or state…'
            autocomplete='off'
            aria-controls='park-gallery'
          />
          <button type='button' id='clear-search' hidden>Clear</button>
          <span id='gallery-status' role='status' aria-live='polite'
            >{photographedParks.length} photographs</span
          >
        </div>
      </div>
      <div class='gallery-stage'>
        <ol
          class='park-gallery interest-gallery'
          tabindex='0'
          aria-roledescription='carousel'
          id='park-gallery'
          aria-label='National park photographs, in personal ranking order'
        >
          {
            photographedParks.map((park) => (
              <li
                class='park-card'
                id={`park-${park.rank}`}
                value={park.rank}
                data-portrait={park.photo!.height > park.photo!.width}
                style={`--image-ratio: ${park.photo!.width / park.photo!.height}`}
                data-search={`${park.name} ${park.state}`.toLowerCase()}
              >
                <a
                  class='gallery-image park-image'
                  href={park.original}
                  data-gallery='parks'
                  data-caption={`${String(park.rank).padStart(2, '0')} · ${park.name}`}
                  data-detail={park.state}
                  aria-label={`Enlarge photo: ${park.name}`}
                >
                  <Image
                    src={park.photo!}
                    alt={park.alt}
                    widths={[400, 800, 1200]}
                    sizes='(max-width: 600px) 90vw, 640px'
                    width={800}
                    loading='lazy'
                  />
                  <span class='image-expand' aria-hidden='true'>
                    View photograph ↗
                  </span>
                </a>
                <div class='park-caption'>
                  <span class='park-number'>{String(park.rank).padStart(2, '0')}</span>
                  <div>
                    <>
                      <h3>{park.name}</h3>
                      <p>{park.state}</p>
                    </>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
        <button
          class='gallery-edge gallery-edge-prev'
          type='button'
          data-step='-1'
          aria-label='Previous photograph'
          aria-controls='park-gallery'
          hidden>‹</button
        >
        <button
          class='gallery-edge gallery-edge-next'
          type='button'
          data-step='1'
          aria-label='Next photograph'
          aria-controls='park-gallery'
          hidden>›</button
        >
      </div>
      <div class='gallery-navigation' data-for='park-gallery' hidden>
        <p>‹ Swipe or scroll · the gallery loops ›</p>
        <div>
          <button
            type='button'
            data-step='-1'
            aria-label='Previous photograph'
            aria-controls='park-gallery'>←</button
          >
          <span class='gallery-position' aria-live='polite' aria-atomic='true'></span>
          <button
            type='button'
            data-step='1'
            aria-label='Next photograph'
            aria-controls='park-gallery'>→</button
          >
        </div>
      </div>
      <p class='gallery-empty' hidden>
        No photographs match that search. Try another park or state.
      </p>
    </section>

    <section class='about-section' aria-labelledby='painting'>
      <div class='about-section-heading'>
        <div>
          <p class='eyebrow'>A different kind of observation</p><h2 id='painting'>Painting</h2>
        </div>
        <span class='collection-count'>Selected personal work</span>
      </div>
      <p>I paint in my spare time. Here are a few of my studies and portraits.</p>
      <div class='gallery-stage'>
        <div
          class='art-gallery interest-gallery'
          id='art-gallery'
          tabindex='0'
          aria-label='Paintings'
          aria-roledescription='carousel'
        >
          {
            paintings.map(({ file, label, ratio }, index) => (
              <figure style={`--image-ratio: ${ratio}`} data-portrait={ratio < 1}>
                <a
                  class='gallery-image art-image'
                  href={`/arts/${file}.gif`}
                  data-gallery='art'
                  data-caption={label}
                  data-detail='Personal artwork'
                  aria-label={`Enlarge painting: ${label}`}
                >
                  <img src={`/arts/${file}.gif`} alt={label} loading='lazy' />
                  <span class='image-expand' aria-hidden='true'>
                    View painting ↗
                  </span>
                </a>
                <figcaption>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  {label}
                </figcaption>
              </figure>
            ))
          }
        </div>
        <button
          class='gallery-edge gallery-edge-prev'
          type='button'
          data-step='-1'
          aria-label='Previous painting'
          aria-controls='art-gallery'
          hidden>‹</button
        >
        <button
          class='gallery-edge gallery-edge-next'
          type='button'
          data-step='1'
          aria-label='Next painting'
          aria-controls='art-gallery'
          hidden>›</button
        >
      </div>
      <div class='gallery-navigation' data-for='art-gallery' hidden>
        <p>‹ Swipe or scroll · the gallery loops ›</p>
        <div>
          <button
            type='button'
            data-step='-1'
            aria-label='Previous painting'
            aria-controls='art-gallery'>←</button
          >
          <span class='gallery-position' aria-live='polite' aria-atomic='true'></span>
          <button type='button' data-step='1' aria-label='Next painting' aria-controls='art-gallery'
            >→</button
          >
        </div>
      </div>
    </section>

    <aside class='football-note'>
      <img
        src='/travels/football.jpeg'
        alt='Cheering at a Notre Dame football game'
        loading='lazy'
      />
      <div>
        <p class='eyebrow'>Go Irish!</p><h2>Still cheering for Notre Dame.</h2><p>
          I’m also a Notre Dame football fan!
        </p>
      </div>
    </aside>
  </div>

  <dialog class='photo-viewer' aria-labelledby='viewer-title'>
    <div class='viewer-toolbar'>
      <span id='viewer-position' role='status' aria-live='polite'></span><button
        type='button'
        id='viewer-close'
        aria-label='Close photo viewer'>Close ✕</button
      >
    </div>
    <div class='viewer-stage'>
      <button type='button' id='viewer-prev' aria-label='Previous photograph'>←</button><img
        id='viewer-image'
        alt=''
      /><button type='button' id='viewer-next' aria-label='Next photograph'>→</button>
    </div>
    <div class='viewer-caption'>
      <div><h2 id='viewer-title'></h2><p id='viewer-detail'></p></div><a
        id='viewer-original'
        target='_blank'
        rel='noopener noreferrer'>Open original ↗</a
      >
    </div>
    <p class='viewer-hint'>Use ← and → to browse · Esc to close</p>
  </dialog>
</PageLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.photo-viewer')!
  const image = document.querySelector<HTMLImageElement>('#viewer-image')!
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-gallery]'))
  let group: HTMLAnchorElement[] = []
  let position = 0
  let opener: HTMLAnchorElement | null = null
  let savedOverflow = ''
  function showPhoto(index: number) {
    position = (index + group.length) % group.length
    const link = group[position]
    image.src = link.href
    image.alt = link.querySelector('img')?.alt || link.dataset.caption || ''
    document.querySelector('#viewer-title')!.textContent = link.dataset.caption || ''
    document.querySelector('#viewer-detail')!.textContent = link.dataset.detail || ''
    document.querySelector('#viewer-position')!.textContent = `${position + 1} / ${group.length}`
    document.querySelector<HTMLAnchorElement>('#viewer-original')!.href = link.href
  }
  for (const link of links) {
    link.addEventListener('click', (event) => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return
      event.preventDefault()
      opener = link
      group = links.filter(
        (item) => item.dataset.gallery === link.dataset.gallery && !item.closest('[hidden]')
      )
      showPhoto(group.indexOf(link))
      savedOverflow = document.body.style.overflow
      document.body.style.overflow = 'hidden'
      dialog.showModal()
      document.querySelector<HTMLButtonElement>('#viewer-close')!.focus()
    })
  }
  document.querySelector('#viewer-close')!.addEventListener('click', () => dialog.close())
  document.querySelector('#viewer-prev')!.addEventListener('click', () => showPhoto(position - 1))
  document.querySelector('#viewer-next')!.addEventListener('click', () => showPhoto(position + 1))
  dialog.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
      event.preventDefault()
      showPhoto(position + (event.key === 'ArrowLeft' ? -1 : 1))
    }
  })
  dialog.addEventListener('click', (event) => {
    const rect = dialog.getBoundingClientRect()
    if (
      event.target === dialog &&
      (event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom)
    )
      dialog.close()
  })
  dialog.addEventListener('close', () => {
    document.body.style.overflow = savedOverflow
    image.removeAttribute('src')
    opener?.focus({ preventScroll: true })
  })

  const search = document.querySelector<HTMLInputElement>('#park-search')!
  const clear = document.querySelector<HTMLButtonElement>('#clear-search')!
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.park-card'))
  function filterParks() {
    const query = search.value.trim().toLowerCase()
    let visible = 0
    cards.forEach((card) => {
      card.hidden = !card.dataset.search!.includes(query)
      if (!card.hidden) visible++
    })
    clear.hidden = !query
    document.querySelector('#gallery-status')!.textContent =
      `${visible} of ${cards.length} photographs`
    document.querySelector<HTMLElement>('.gallery-empty')!.hidden = visible !== 0
    document.querySelector('#park-gallery')!.dispatchEvent(new Event('gallery-filter'))
  }
  search.addEventListener('input', filterParks)
  clear.addEventListener('click', () => {
    search.value = ''
    filterParks()
    search.focus()
  })
  document.querySelector<HTMLElement>('.gallery-tools')!.hidden = false
  document.querySelectorAll<HTMLAnchorElement>('.park-directory a').forEach((link) => {
    link.addEventListener('click', () => {
      search.value = ''
      filterParks()
    })
  })

  // Three copies form a continuous ring. Once scrolling settles, recenter the
  // equivalent original without animation; the surrounding images stay identical.
  document.querySelectorAll<HTMLElement>('.interest-gallery').forEach((rail) => {
    const navigation = document.querySelector<HTMLElement>(`[data-for="${rail.id}"]`)!
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(`button[aria-controls="${rail.id}"][data-step]`)
    )
    const counter = navigation.querySelector<HTMLElement>('.gallery-position')!
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const originals = Array.from(rail.children) as HTMLElement[]
    let visible: HTMLElement[] = []
    let slides: HTMLElement[] = []
    let current = 0
    let frame = 0
    let settleTimer: ReturnType<typeof setTimeout>
    const centerOn = (slide: HTMLElement, smooth = false) => {
      rail.scrollTo({
        left: slide.offsetLeft + slide.offsetWidth / 2 - rail.clientWidth / 2,
        behavior: smooth && !reducedMotion.matches ? 'smooth' : 'instant'
      })
    }
    const update = () => {
      frame = 0
      const center = rail.scrollLeft + rail.clientWidth / 2
      const radius = Math.max(650, rail.clientWidth)
      rail.style.setProperty('--camera-distance', `${Math.max(1000, rail.clientWidth * 1.5)}px`)
      let nearest = Infinity
      slides.forEach((slide, index) => {
        const offset = slide.offsetLeft + slide.offsetWidth / 2 - center
        const distance = Math.abs(offset)
        if (distance < nearest) {
          nearest = distance
          current = index
        }
        // Arc length determines the angle; position and orientation share one
        // circle on the X/Z ground plane: x² + (z + radius)² = radius².
        const angle = offset / radius
        const theta = Math.max(-1.35, Math.min(angle, 1.35))
        slide.style.visibility = Math.abs(angle) <= 1.35 ? 'visible' : 'hidden'
        slide.style.zIndex = String(Math.round((1 - Math.abs(theta) / 1.35) * 1000))
        slide.style.setProperty('--gallery-offset', `${offset}px`)
        slide.style.setProperty('--circle-x', `${radius * Math.sin(theta)}px`)
        slide.style.setProperty('--circle-z', `${radius * (Math.cos(theta) - 1)}px`)
        slide.style.setProperty('--circle-angle', `${theta}rad`)
        slide.style.setProperty(
          '--gallery-opacity',
          String(1 - Math.min(Math.abs(theta) / 1.35, 1) * 0.38)
        )
      })
      const logicalIndex = visible.length ? current % visible.length : 0
      counter.textContent = visible.length ? `${logicalIndex + 1} / ${visible.length}` : ''
    }
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update)
    }
    const reflect = (slide: HTMLElement) => {
      slide.querySelectorAll<HTMLImageElement>('.gallery-image > img').forEach((photo) => {
        const sync = () =>
          photo.parentElement!.style.setProperty(
            '--reflection-image',
            `url("${photo.currentSrc || photo.src}")`
          )
        photo.addEventListener('load', sync)
        if (photo.complete) sync()
      })
    }
    const clone = (original: HTMLElement) => {
      const copy = original.cloneNode(true) as HTMLElement
      copy.dataset.clone = 'true'
      copy.setAttribute('aria-hidden', 'true')
      copy.removeAttribute('id')
      copy.querySelectorAll('[id]').forEach((element) => element.removeAttribute('id'))
      copy.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
        link.tabIndex = -1
        link.addEventListener('click', (event) => {
          if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return
          event.preventDefault()
          original.querySelector<HTMLAnchorElement>('a')!.click()
        })
      })
      reflect(copy)
      return copy
    }
    const rebuild = () => {
      clearTimeout(settleTimer)
      rail.querySelectorAll('[data-clone]').forEach((copy) => copy.remove())
      visible = originals.filter((slide) => !slide.hidden)
      if (visible.length > 1) {
        rail.prepend(...visible.map(clone))
        rail.append(...visible.map(clone))
      }
      slides = Array.from(rail.children).filter(
        (slide) => !(slide as HTMLElement).hidden
      ) as HTMLElement[]
      navigation.hidden = !visible.length
      buttons.forEach((button) => {
        button.hidden = !visible.length
        button.disabled = visible.length < 2
      })
      rail.hidden = !visible.length
      if (visible.length) centerOn(visible[0])
      update()
    }
    const settle = () => {
      update()
      const slide = slides[current]
      if (slide?.dataset.clone && visible.length > 1) {
        centerOn(visible[current % visible.length])
        update()
      }
    }
    const step = (direction: number) => {
      if (visible.length < 2) return
      settle()
      centerOn(slides[current + direction], true)
    }
    buttons.forEach((button) =>
      button.addEventListener('click', () => step(Number(button.dataset.step)))
    )
    rail.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault()
        step(event.key === 'ArrowLeft' ? -1 : 1)
      }
    })
    rail.addEventListener(
      'scroll',
      () => {
        schedule()
        clearTimeout(settleTimer)
        settleTimer = setTimeout(settle, 160)
      },
      { passive: true }
    )
    rail.addEventListener('gallery-filter', rebuild)
    originals.forEach(reflect)
    new ResizeObserver(() => {
      if (visible.length) centerOn(visible[current % visible.length])
      schedule()
    }).observe(rail)
    rebuild()
  })
</script>

<style>
  .about-page .eyebrow {
    font-size: 0.7rem;
    color: var(--green);
    margin: 0 0 10px;
  }
  .about-section {
    padding: 42px 0;
    border-top: 1px solid var(--line);
  }
  .about-section:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .about-section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
  }
  .about-section-heading h2 {
    margin: 0;
    font-size: 1.6rem;
    letter-spacing: -0.025em;
  }
  .collection-count {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .park-directory {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 16px 20px;
    margin: 24px 0;
    background: var(--park-surface);
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
  }
  summary > span {
    float: right;
    font-weight: 400;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .park-directory ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 28px;
    list-style: none;
    padding: 24px 0 4px;
    margin: 0;
  }
  .park-directory li {
    display: flex;
    gap: 12px;
    align-items: start;
    font-size: 0.88rem;
  }
  .park-directory small {
    display: block;
    color: var(--text-muted);
    font-size: 0.75rem;
    margin-top: 3px;
  }
  .park-number {
    color: var(--green);
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }
  .gallery-tools {
    margin: 28px 0 22px;
  }
  .gallery-tools > label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .search-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  input {
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 6px;
    padding: 10px 14px;
    min-width: 0;
    width: min(100%, 350px);
    font: inherit;
    font-size: 0.88rem;
  }
  input:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 3px;
  }
  .search-row button {
    color: var(--green);
    cursor: pointer;
    font-size: 0.85rem;
    padding: 8px;
  }
  #gallery-status {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-left: auto;
  }
  .park-gallery {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .park-card {
    min-width: 0;
    scroll-margin-top: 24px;
  }
  .park-card:target .park-caption {
    background: var(--soft-green);
    border-radius: 6px;
  }
  .gallery-image {
    display: block;
    position: relative;
    border-radius: 8px;
    background: var(--soft-green);
    box-shadow:
      0 18px 30px -16px #0008,
      0 3px 10px #0002;
  }
  .park-image,
  .art-image {
    height: var(--item-height);
  }
  .gallery-image > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: inherit;
  }
  .gallery-image::after {
    content: '';
    pointer-events: none;
    position: absolute;
