---
import PageLayout from '@/layouts/CommonPage.astro'

const headings = [
  { depth: 2, slug: 'background', text: 'Background' },
  { depth: 2, slug: 'painting', text: 'Painting' },
  { depth: 2, slug: 'hiking', text: 'Hiking' }
]
const nationalParks = [
  'Grand Canyon (Arizona)',
  'Yellowstone (Wyoming)',
  'Arches (Utah)',
  'Olympic (Washington)',
  'Mount Rainier (Washington)',
  'Everglades (Florida)',
  'Acadia (Maine)',
  'Saguaro (Arizona)',
  'Bryce Canyon (Utah)',
  'Canyonlands (Utah)',
  'Black Canyon of the Gunnison (Colorado)',
  'North Cascades (Washington)',
  'Shenandoah (Virginia)',
  'Mammoth Cave (Kentucky)',
  'Biscayne (Florida)',
  'Petrified Forest (Arizona)',
  'Mesa Verde (Colorado)',
  'Indiana Dunes (Indiana)'
]
const paintings = [
  { file: 'statue', label: 'Statue study' },
  { file: 'guard', label: 'Guard study' },
  { file: 'life', label: 'Still life' },
  { file: 'DV', label: 'DV painting' },
  { file: 'Hannibal', label: 'Hannibal portrait' },
  { file: 'cat', label: 'Cat portrait' }
]
---

<PageLayout title='About' {headings}>
  <h2 id='background'>Background</h2>
  <p>
    I am a Ph.D. student in Computer Science at Johns Hopkins University, advised by
    <a href='https://www.cs.jhu.edu/~yaxing/index.html'>Prof. Yaxing Yao</a>. I study usable privacy
    and security, human-computer interaction, and human-centered AI.
  </p>
  <p>
    I received my B.S. in Computer Science from the University of Notre Dame in 2026, where I worked
    in the <a href='https://toby.li/'>SaNDwich Lab</a> with Prof. Toby Jia-Jun Li. I also worked in the
    <a href='https://cmu-spuds.github.io/cmu-spuds-web/'>SPUD Lab</a>
    at Carnegie Mellon University, advised by <a href='https://sauvik.me/'>Prof. Sauvik Das</a>.
  </p>
  <p><a href='/projects'>Explore my projects →</a></p>

  <h2 id='painting'>Painting</h2>
  <p>Outside of research, I enjoy painting and hiking. Here are a few of my paintings.</p>
  <div class='photo-grid'>
    {
      paintings.map(({ file, label }) => (
        <figure>
          <img src={`/arts/${file}.gif`} alt={label} loading='lazy' />
          <figcaption>{label}</figcaption>
        </figure>
      ))
    }
  </div>

  <h2 id='hiking'>Hiking</h2>
  <p>I’ve hiked in these national parks, listed in order of personal preference.</p>
  <ol class='park-list'>{nationalParks.map((park) => <li>{park}</li>)}</ol>
  <div class='photo-grid'>
    <figure>
      <img
        src='/travels/canyonlands.png'
        alt='A view of Canyonlands National Park'
        loading='lazy'
      />
      <figcaption>Canyonlands National Park</figcaption>
    </figure>
    <figure>
      <img src='/travels/olympic.png' alt='A view of Olympic National Park' loading='lazy' />
      <figcaption>Olympic National Park</figcaption>
    </figure>
  </div>
  <p>I’m also a Notre Dame football fan!</p>
  <figure class='football-photo'>
    <img src='/travels/football.jpeg' alt='Notre Dame football game' loading='lazy' />
  </figure>
</PageLayout>
