---
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'research', text: 'Research' },
  { depth: 2, slug: 'personal', text: 'Personal' },
  { depth: 2, slug: 'course', text: 'Course projects' }
]
---

<PageLayout title='Projects' {headings}>
  <p>A selection of my research, personal, and course projects.</p>

  <h2 id='research'>Research</h2>
  <ProjectSection
    projects={[
      {
        name: 'AROMA',
        description: 'AI assistant to support blind/low-vision cooks.',
        image: 'AROMA.png',
        links: [
          { type: 'doc', href: 'https://dl.acm.org/doi/10.1145/3746059.3747650' },
          { type: 'youtube', href: 'https://www.youtube.com/watch?v=hi7YsFJp5KQ' }
        ]
      },
      {
        name: 'Privacy Auditing Sandbox',
        description: 'End-user auditing of online content recommendations.',
        image: 'PrivacySandbox.png',
        links: [
          { type: 'github', href: 'https://github.com/Leoreoreo/relatedPosts' },
          { type: 'doc', href: 'https://dl.acm.org/doi/10.1145/3746059.3747798' },
          { type: 'youtube', href: 'https://www.youtube.com/watch?v=3I_zgTW02a8' }
        ]
      }
    ]}
  />
  <h2 id='personal'>Personal</h2>
  <ProjectSection
    projects={[
      {
        name: 'SafePrompt',
        description: 'A privacy layer that reduces sensitive information shared with AI chatbots.',
        image: 'SafePrompt.png',
        links: [
          { type: 'github', href: 'https://github.com/lukewarm3/SafePrompt' },
          { type: 'doc', href: 'https://github.com/lukewarm3/SafePrompt/blob/main/Hackathon26.key' }
        ]
      },
      {
        name: 'MindEcho',
        description: 'A meeting assistant for people with hearing or speech disabilities.',
        image: 'mindEcho.png',
        links: [
          { type: 'github', href: 'https://github.com/Leoreoreo/Meeting_Assistant' },
          {
            type: 'doc',
            href: 'https://github.com/Leoreoreo/Meeting_Assistant/blob/main/Hackathon25.key'
          }
        ]
      },
      {
        name: 'A11yVate',
        description: 'A crowdsourced map of campus accessibility information.',
        image: 'A11yVate.png',
        links: [{ type: 'github', href: 'https://github.com/Leoreoreo/A11yVate' }]
      },
      {
        name: 'This Website',
        description: 'My personal website built with Astro.',
        image: 'astro.jpg',
        links: [
          { type: 'github', href: 'https://github.com/Leoreoreo/leoreoreo.github.io' },
          { type: 'site', href: 'https://leoreoreo.github.io' }
        ]
      }
    ]}
  />

  <h2 id='course'>Course projects</h2>
  <ProjectSection
    projects={[
      {
        name: 'Campus Mart',
        description: 'A campus marketplace built with Django and React.',
        image: 'campusMart.jpg',
        links: [
          { type: 'github', href: 'https://github.com/johnkimdw/campus_mart' },
          {
            type: 'doc',
            href: 'https://github.com/johnkimdw/campus_mart/blob/main/Group%205%20Final%20Report.pdf'
          }
        ]
      },
      {
        name: 'P2P Hash Table',
        description: 'A scalable, persistent distributed hash table based on Chord.',
        image: 'p2pHashTable.jpg',
        links: [
          { type: 'github', href: 'https://github.com/Leoreoreo/p2pHashtable' },
          {
            type: 'doc',
            href: 'https://github.com/Leoreoreo/p2pHashtable/blob/main/Peer-to-Peer%20Hash%20Table%20Final%20Report.pdf'
          }
        ]
      },
      {
        name: 'Travel Itinerary Manager',
        description: 'A trip scheduling and planning assistant. (React, Flask)',
        image: 'TIM.jpg',
        links: [{ type: 'github', href: 'https://github.com/Leoreoreo/TravelItineraryManager' }]
      },
      {
        name: 'SAT Solver',
        description:
          'Python implementations of finite automata, regular expressions, sed, and Turing machines.',
        image: 'satSolver.jpg',
        links: [{ type: 'github', href: 'https://github.com/Leoreoreo/SAT_Solver' }]
      },
      {
        name: 'The Kuiper Frontier',
        description: 'A 2D aerial shooting game built with Java.',
        image: 'theKuiperFrontier.png',
        links: [{ type: 'github', href: 'https://github.com/Leoreoreo/theKuiperFrontier' }]
      }
    ]}
  />
</PageLayout>
