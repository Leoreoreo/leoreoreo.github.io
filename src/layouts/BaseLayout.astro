---
import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import ThemeIcon from '@/components/ThemeIcon.astro'
import ThemeScript from '@/components/ThemeScript.astro'
import config from '@/site-config'

import '@/assets/styles/app.css'

interface Props {
  meta: SiteMeta
}
const {
  meta: { articleDate, description = config.description, ogImage, title }
} = Astro.props
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
const menu = [{ title: 'Home', link: '/' }, ...(config.header.menu ?? [])]
---

<html lang={config.locale.lang}>
  <head><BaseHead {articleDate} {description} {ogImage} {title} /><ThemeScript /></head>
  <body>
    <a class='skip-link' href='#main-content'>Skip to content</a>
    <div class='site-shell'>
      <header class='site-header'>
        <a class='site-name' href='/'>{config.author}</a>
        <div class='header-controls'>
          <nav aria-label='Main navigation'>
            {
              menu.map((item) => (
                <a href={item.link} aria-current={currentPath === item.link ? 'page' : undefined}>
                  {item.title}
                </a>
              ))
            }
          </nav>
          <details class='theme-control' data-preference='system' hidden>
            <summary aria-label='Color theme: System' title='Color theme'>
              {
                ['system', 'light', 'dark'].map((mode) => (
                  <span data-theme-symbol={mode}>
                    <ThemeIcon {mode} />
                  </span>
                ))
              }
            </summary>
            <div class='theme-options' role='group' aria-label='Color theme'>
              {
                ['system', 'light', 'dark'].map((mode) => (
                  <button
                    type='button'
                    data-theme-option={mode}
                    aria-label={
                      mode === 'system'
                        ? 'System appearance'
                        : `${mode === 'light' ? 'Light' : 'Dark'} mode`
                    }
                    title={mode === 'system' ? 'System' : mode === 'light' ? 'Light' : 'Dark'}
                    aria-pressed={mode === 'system'}
                  >
                    <ThemeIcon {mode} />
                  </button>
                ))
              }
            </div>
          </details>
        </div>
      </header>
      <div class='site-content'><slot /></div>
      <footer class='site-footer'>
        <span>© {new Date().getFullYear()} {config.author}</span>
        <div>
          <a href='mailto:lli184@jh.edu'>Email</a><a href='https://github.com/Leoreoreo'>GitHub</a>
        </div>
      </footer>
    </div>
  </body>
</html>
