---
interface Props {
  title: string
  skills: string[]
}
const { title, skills } = Astro.props
---

<div class='skill-row'>
  <h3>{title}</h3>
  <p>{skills.join(' · ')}</p>
</div>
<style>
  .skill-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 16px;
  }
  h3,
  p {
    margin: 0;
  }
  p {
    color: var(--text-muted);
  }
  @media (max-width: 600px) {
    .skill-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
